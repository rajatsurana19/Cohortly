# Application
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (Supabase / PostgreSQL)
# Direct connection URL (URI encoded password if it contains special characters)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require&connect_timeout=30
# Direct connection string for Prisma or Pg pooler
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require&connect_timeout=30

# Supabase API (Optional for direct SDK access)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# JWT Secrets
JWT_SECRET=cohortly_super_secure_jwt_secret_change_in_production_2026
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=cohortly_super_secure_refresh_secret_2026
REFRESH_TOKEN_EXPIRES_IN=30d

{
  "name": "cohortly",
  "version": "1.0.0",
  "private": true,
  "description": "Cohortly - Academic Group & Assignment Management Platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^5.22.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.68.8",
    "@rollup/rollup-linux-x64-musl": "4.68.8"
  }
}
